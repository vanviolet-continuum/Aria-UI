{
  "name": "aria-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:examples": "vite --config examples/vite.config.ts",
    "build": "tsc -b && vite build",
    "build:examples": "tsc -p examples/tsconfig.json && vite build --config examples/vite.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:examples": "vite preview --config examples/vite.config.ts",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fullcalendar/react": "^7.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.5.11",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.9",
    "react-number-format": "^5.4.5",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
